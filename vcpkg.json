{
  "name": "relaydesk",
  "version-string": "0.1.0",
  "dependencies": [
    "boost-asio",
    "nlohmann-json"
  ],
  "features": {
    "skia-renderer": {
      "description": "Skia renderer dependencies for EUI-NEO and the SkiaUI executable.",
      "dependencies": [
        {
          "name": "skia",
          "default-features": false,
          "features": [
            "gl",
            "direct3d"
          ]
        },
        {
          "name": "skiaui",
          "features": [
            "win32-dx12"
          ]
        }
      ]
    }
  }
}
